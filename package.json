{
  "name": "openmusic",
  "version": "0.1.0",
  "description": "OpenMusic — local-first music player for Android and Windows (Lynx / ReactLynx)",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rspeedy build",
    "build:android": "rspeedy build --platform android",
    "build:windows": "rspeedy build --platform windows",
    "dev": "rspeedy dev",
    "dev:android": "rspeedy dev --platform android",
    "dev:windows": "rspeedy dev --platform windows",
    "preview": "rspeedy preview",
    "prepare:windows-host": "node scripts/prepare-windows-host.mjs",
    "serve:windows-host": "node scripts/serve-windows-host.mjs",
    "bench:music-repo": "tsx scripts/bench-music-repository.mts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "rstest run",
    "test:watch": "rstest dev",
    "typecheck": "tsc --build --force",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@lynx-js/react": "^0.126.2",
    "remote-web-worker": "^0.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lynx-js/preact-devtools": "^5.0.1-20260827072047-5f77e12",
    "@lynx-js/qrcode-rsbuild-plugin": "^0.7.3",
    "@lynx-js/react-rsbuild-plugin": "^0.20.3",
    "@lynx-js/rspeedy": "^0.18.0",
    "@lynx-js/types": "^4.1.0",
    "@rsbuild/plugin-type-check": "^1.6.0",
    "@rstest/core": "^0.12.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/react": "^19.2.18",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "jsdom": "^27.4.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
