# Keep source and configuration files stable across Windows and CI.
* text=auto

# Git control files must also be deterministic; otherwise global
# core.autocrlf=true can make .gitattributes warn about itself.
.gitattributes text eol=lf
.gitignore text eol=lf

*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# Windows command scripts require CRLF for maximum compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp3 binary
*.flac binary
*.wav binary
*.ogg binary
*.aac binary
*.m4a binary
*.apk binary
*.aab binary
*.exe binary
*.dll binary
*.zip binary
*.jar binary
